{
  "name": "codeflare",
  "version": "0.0.0",
  "description": "Generate beautiful code screenshots powered by Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deploy": "vp check && vp build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "vpx auth generate --output ./src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@cloudflare/kumo": "^2.16.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-simple-code-editor": "^0.14.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "packageManager": "npm@11.19.0"
}
